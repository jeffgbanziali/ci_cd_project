# Copier en .env pour l'usage local (docker compose le lit automatiquement)
POSTGRES_DB=financial_db
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=pipeline_password
DB_URL=postgresql://pipeline_user:pipeline_password@localhost:5432/financial_db
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=transactions-bucket
RETRY_MAX_ATTEMPTS=3
RETRY_WAIT_SECONDS=2
# Simulation de pannes (retry) : nombre de pannes à provoquer au démarrage
SIMULATE_DB_FAILURES=0
SIMULATE_S3_FAILURES=0
# Option 3 (SLM via Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
